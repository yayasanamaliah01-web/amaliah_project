# ====================================================
# MAUN Semarang Infak - Environment Configuration
# ====================================================

# Payment Gateway Provider: "xendit" (Production / Development) or "simulator" (Local Bank Simulator)
PAYMENT_GATEWAY_PROVIDER=xendit

# Xendit API Credentials
# Dapatkan Secret Key dari Dashboard Xendit > Settings > API Keys
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here
XENDIT_API_URL=https://api.xendit.co
XENDIT_WEBHOOK_TOKEN=your_webhook_verification_token_here
XENDIT_SIMULATION_ENABLED=true

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/maun_db
DB_USERNAME=postgres
DB_PASSWORD=root

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

